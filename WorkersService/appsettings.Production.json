{
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres-workers;Port=5432;Database=WorkersServiceDb;Username=postgres;Password=postgres;"
  },
  
  "WorkerProgressNotifier": {
    "GatewayUrl": "http://api-gateway:5095"
  },
  
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "Topic": "task-created",
    "ConsumerGroup": "workers-group"
  },
  
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss:fff} {Level:u3} ({CorrelationId})] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss:fff} {Level:u3} ({CorrelationId})] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
